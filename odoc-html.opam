opam-version: "2.0"

version: "dev"
homepage: "https://github.com/ocaml/odoc"
doc: "https://ocaml.github.io/odoc/"
bug-reports: "https://github.com/ocaml/odoc/issues"
license: "ISC"

maintainer: [
  "Daniel Bünzli <daniel.buenzli@erratique.ch>"
  "Jon Ludlam <jon@recoil.org>"
  "Jules Aguillon <juloo.dsi@gmail.com>"
  "Paul-Elliot Anglès d'Auriac <paul-elliot@tarides.com>"
]
authors: [
  "Anton Bachin <antonbachin@yahoo.com>"
  "Daniel Bünzli <daniel.buenzli@erratique.ch>"
  "David Sheets <sheets@alum.mit.edu>"
  "Jon Ludlam <jon@recoil.org>"
  "Jules Aguillon <juloo.dsi@gmail.com>"
  "Leo White <leo@lpw25.net>"
  "Lubega Simon <lubegasimon73@gmail.com>"
  "Paul-Elliot Anglès d'Auriac <paul-elliot@tarides.com>"
  "Thomas Refis <trefis@janestreet.com>"
]
dev-repo: "git+https://github.com/ocaml/odoc.git"

synopsis: "HTML generator for OCaml documentation produced by odoc"
description: """
**odoc-html** is the HTML output backend for odoc. It provides the
`odoc-html` binary with subcommands (`generate`, `generate-source`,
`generate-asset`, `fragment`, `url`, `support-files`) consumed by build
systems and CI tooling to render the linked `.odocl` files produced by
the core `odoc` package into HTML.

This package was split out of the core `odoc` package so that users who
do not need HTML output (for example, programmatic consumers of `.odocl`
files or alternative renderers) can install `odoc` without pulling in
the `tyxml` dependency.
"""

depends: [
  "odoc" {= version}
  "astring"
  "cmdliner" {>= "1.3.0"}
  "cppo" {build & >= "1.1.0"}
  "crunch" {build & >= "1.4.1"}
  "dune" {>= "3.21.0"}
  "fpath" {>= "0.7.3"}
  "ocaml" {>= "4.08.0" & < "5.6"}
  "tyxml" {>= "4.4.0"}
  "fmt"
  "ocamlfind" {with-test}
  "yojson" {>= "2.1.0" & with-test}
  "sexplib0" {with-test}
  "conf-jq" {with-test}
  "ppx_expect" {with-test}
]

conflicts: [
  "ocaml-option-bytecode-only"
  "oxcaml-compiler" {< "5.2.0minus31"}
]

build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
