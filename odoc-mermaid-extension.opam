opam-version: "2.0"
version: "dev"
synopsis: "Mermaid diagram support for odoc documentation"
description: """
Renders {@mermaid[...]} code blocks as interactive diagrams.
Supports flowcharts, sequence diagrams, class diagrams, and more."""
maintainer: ["Jon Ludlam <jon@recoil.org>"]
authors: ["Jon Ludlam <jon@recoil.org>"]
license: "ISC"
homepage: "https://github.com/ocaml/odoc"
bug-reports: "https://github.com/ocaml/odoc/issues"
dev-repo: "git+https://github.com/ocaml/odoc.git"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "4.14"}
  "odoc" {= version}
]
build: [
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
  ]
]
x-maintenance-intent: ["(latest)"]
